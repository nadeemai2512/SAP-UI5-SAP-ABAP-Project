{
  "global": { "files": "/src/**/*.*", "skipGeneratedGatewayClasses": true },
  "syntax": { "version": "v755", "errorNamespace": "^(Z|Y|LCL_|TY_|LIF_)" },
  "rules": {
    "parser_error": true,
    "check_syntax": true,
    "unknown_types": true,
    "unused_variables": true,
    "unused_types": true,
    "unreachable_code": true,
    "empty_statement": true
  }
}
