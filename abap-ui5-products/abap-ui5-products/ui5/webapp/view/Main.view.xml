<mvc:View
  controllerName="com.demo.abapproducts.controller.Main"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  displayBlock="true">
  <Page id="page" title="{i18n>appTitle}" busy="{view>/busy}">
    <content>
      <MessageStrip text="{i18n>mockBanner}" type="Information" showIcon="true"
        visible="{view>/mock}" class="sapUiSmallMargin"/>
      <HBox class="sapUiSmallMargin" wrap="Wrap">
        <VBox class="sapUiMediumMarginEnd">
          <Label text="{i18n>statCount}"/>
          <ObjectNumber number="{view>/count}" emphasized="true"/>
        </VBox>
        <VBox class="sapUiMediumMarginEnd">
          <Label text="{i18n>statValue}"/>
          <ObjectNumber number="{view>/value}" unit="EUR" emphasized="true"/>
        </VBox>
        <VBox>
          <Label text="{i18n>statLow}"/>
          <ObjectNumber number="{view>/low}" state="{= ${view>/low} > 0 ? 'Warning' : 'Success' }" emphasized="true"/>
        </VBox>
      </HBox>
      <Table id="productTable" mode="SingleSelectLeft" growing="true" growingThreshold="25"
        items="{ path: 'products>/items', sorter: { path: 'name' } }">
        <headerToolbar>
          <OverflowToolbar>
            <Title text="{i18n>products}" level="H2"/>
            <ToolbarSpacer/>
            <SearchField width="16rem" placeholder="{i18n>search}" search=".onSearch"/>
            <Button icon="sap-icon://add" text="{i18n>add}" type="Emphasized" press=".onAdd"/>
            <Button icon="sap-icon://edit" text="{i18n>edit}" press=".onEdit"/>
            <Button icon="sap-icon://add-product" text="{i18n>restock}" press=".onRestock"/>
            <Button icon="sap-icon://delete" text="{i18n>delete}" type="Reject" press=".onDelete"/>
          </OverflowToolbar>
        </headerToolbar>
        <columns>
          <Column><Text text="{i18n>name}"/></Column>
          <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>category}"/></Column>
          <Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>description}"/></Column>
          <Column hAlign="End"><Text text="{i18n>price}"/></Column>
          <Column hAlign="End"><Text text="{i18n>stock}"/></Column>
        </columns>
        <items>
          <ColumnListItem>
            <cells>
              <ObjectIdentifier title="{products>name}"/>
              <Text text="{products>category}"/>
              <Text text="{products>description}"/>
              <ObjectNumber
                number="{ path: 'products>price', type: 'sap.ui.model.type.Float', formatOptions: { minFractionDigits: 2, maxFractionDigits: 2 } }"
                unit="{products>currency}"/>
              <ObjectStatus text="{products>stock}"
                state="{= ${products>stock} === 0 ? 'Error' : ${products>stock} &lt; 10 ? 'Warning' : 'Success' }"/>
            </cells>
          </ColumnListItem>
        </items>
      </Table>
    </content>
  </Page>
</mvc:View>
